    {"week": 5, "date": "2026-10-08", "title": "Intermediate SQL", "materials": ["ch04"], "coverage": "Explicit and outer joins, ON and WHERE, views, constraints, reference actions, and basic transactions."},
    {"week": 6, "date": "2026-10-15", "title": "Written Exam 1", "materials": ["ch02", "ch03", "ch04"], "coverage": "Written Exam 1 on the selected classroom material from Chapters 2-4."},
    {"week": 7, "date": "2026-10-22", "title": "Selected Advanced SQL", "materials": ["ch05"], "coverage": "Ranking and window functions, recursive CTEs, one audit trigger, and stored-routine purpose and interface."},
    {"week": 8, "date": "2026-10-29", "title": "E-R Design Foundations", "materials": ["ch06"], "coverage": "Requirements, entities, attributes, relationships, roles, cardinality, participation, keys, and weak entities."},
    {"week": 9, "date": "2026-11-05", "title": "Asynchronous Review", "materials": ["ch02", "ch03", "ch04", "ch05"], "coverage": "No class, examination, or new material; asynchronous review while the instructor attends INFORMS."},
    {"week": 10, "date": "2026-11-12", "title": "E-R Design and Relational Mapping", "materials": ["ch06"], "coverage": "Redundancy, design choices, E-R-to-relational mapping, keys, foreign keys, and mapped-schema verification."},
    {"week": 11, "date": "2026-11-19", "title": "Normalization", "materials": ["ch07"], "coverage": "Anomalies, functional dependencies, closure, lossless decomposition, spurious tuples, and introductory 3NF and BCNF."},
    {"week": 12, "date": "2026-11-26", "title": "Written Exam 2", "materials": ["ch05", "ch06", "ch07"], "coverage": "Written Exam 2 on the selected classroom material from Chapters 5-7."},
    {"week": 13, "date": "2026-12-03", "title": "Indexing", "materials": ["ch14"], "coverage": "Index purpose, B+ tree access, composite-column order, covering indexes, and query-plan evidence."},
    {"week": 14, "date": "2026-12-10", "title": "Query Processing and Optimization", "materials": ["ch15", "ch16"], "coverage": "Scans and searches, join access order, equivalence checks, selectivity, statistics, ANALYZE, and plan interpretation."},
    {"week": 15, "date": "2026-12-17", "title": "Transactions", "materials": ["ch17"], "coverage": "Transaction boundaries, ACID, states, schedules, conflicts, precedence graphs, recoverability, and isolation phenomena."},
    {"week": 16, "date": "2026-12-24", "title": "Concurrency Control, Recovery, and Review", "materials": ["ch18", "ch19"], "coverage": "S/X locks, grant and wait, deadlock, log records, WAL, simplified redo and undo, and integrated review."},
